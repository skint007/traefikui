# Traefik API URL (internal Docker network)
TRAEFIK_API_URL=http://traefik:8080

# Config directory mounted from Traefik
CONFIG_DIR=/traefik-config

# SQLite database path for auth
DATABASE_URL=file:/app/data/auth.db

# BetterAuth secret (generate a random string)
BETTER_AUTH_SECRET=your-secret-here

# Public URL for the app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SSRF protection mode for outbound requests to agent servers.
# Default (unset/0): blocks loopback, link-local (incl. cloud metadata),
# multicast, and 0.0.0.0/8 — RFC1918 / Docker / LAN ranges are allowed.
# Strict (1): also blocks 10/8, 172.16/12, 192.168/16, CGNAT, and IPv6 ULA.
# Enable strict only if your master has no legitimate need to reach private
# LAN agents (e.g. a hosted multi-tenant deployment).
# TRAEFIKUI_STRICT_SSRF=0
