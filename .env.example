# Traefik API URL (internal Docker network)
TRAEFIK_API_URL=http://traefik:8080

# Config directory mounted from Traefik
CONFIG_DIR=/traefik-config

# SQLite database path for auth
DATABASE_URL=file:/app/data/auth.db

# BetterAuth secret (generate a random string)
BETTER_AUTH_SECRET=your-secret-here

# Public URL for the app
NEXT_PUBLIC_APP_URL=http://localhost:3000
